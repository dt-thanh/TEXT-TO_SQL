# Secrets. TODO: Keep real credentials out of version control.
.env
.env.*
!.env.example
# Private keys belong in ~/.snowflake, never in the repo.
*.p8
*.pem

# Python caches and environments.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Generated data and evaluation output.
data/generated/
eval/results/*
!eval/results/.gitkeep

# Local editor and OS files.
.idea/
.vscode/
.DS_Store

# dbt build output and downloaded packages (re-created by `make dbt-deps` / `make dbt-build`).
dbt/target/
dbt/logs/
dbt/dbt_packages/
