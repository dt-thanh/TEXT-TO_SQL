# Secrets: never commit them.
.env
.env.*
!.env.example
# Private keys belong in ~/.snowflake, never in the repo.
*.p8
*.pem

# Python caches and environments.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Generated data and evaluation output.
eval/results/*
!eval/results/.gitkeep

# Local editor and OS files.
.idea/
.vscode/
.DS_Store

# dbt build output, downloaded packages and per-machine user id (re-created automatically).
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Airflow task logs written by the containers.
airflow/logs/
