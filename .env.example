# Copy to .env and fill in locally. Never commit .env.

# Snowflake service user with key-pair auth (see infra/snowflake/00_setup.sql).
# Account: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=FINSIGHT_SVC
SNOWFLAKE_ROLE=FINSIGHT_ENGINEER
SNOWFLAKE_WAREHOUSE=FINSIGHT_WH
SNOWFLAKE_DATABASE=FINSIGHT
# Absolute path; "~" is not expanded.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Text-to-SQL agent: its own read-only Snowflake user (infra/snowflake/02_agent_user.sql).
SNOWFLAKE_AGENT_USER=FINSIGHT_AGENT_SVC
SNOWFLAKE_AGENT_ROLE=FINSIGHT_AGENT
# Absolute path; "~" is not expanded.
SNOWFLAKE_AGENT_PRIVATE_KEY_PATH=

# The API's own Snowflake user: CONTROL rows only (infra/snowflake/03_control_access.sql).
SNOWFLAKE_APP_USER=FINSIGHT_APP_SVC
SNOWFLAKE_APP_ROLE=FINSIGHT_APP
# Absolute path; "~" is not expanded.
SNOWFLAKE_APP_PRIVATE_KEY_PATH=

# Airflow REST API, to start asset onboarding at once (empty: the daily run picks requests up).
# From the host: http://localhost:8081. From the API container: http://host.docker.internal:8081.
AIRFLOW_API_URL=
AIRFLOW_API_USER=
AIRFLOW_API_PASSWORD=

# local: API/UI on 127.0.0.1 only, no key. deployed: X-API-Key required (FINSIGHT_SERVICE_KEY).
AUTH_MODE=local
FINSIGHT_SERVICE_KEY=
# Every LLM call of one UTC day together stops at this many USD.
LLM_DAILY_COST_CAP_USD=1.0
# Language of the scheduled daily brief: en | vi.
BRIEF_LANGUAGE=en

# Public market data; no API key needed.
BINANCE_BASE_URL=https://api.binance.com

FRED_API_KEY=

# OpenAI model for the Text-to-SQL agent. The cost shown per question uses
# LLM_INPUT_USD_PER_1M / LLM_OUTPUT_USD_PER_1M (defaults: gpt-4.1-mini prices); change them with the model.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Only for reasoning models such as gpt-5-mini (they reject temperature=0): minimal | low | medium | high.
LLM_REASONING_EFFORT=

LOG_LEVEL=INFO
# text | json (one JSON object per line, for a log collector)
LOG_FORMAT=text
