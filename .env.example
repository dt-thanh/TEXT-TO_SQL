# Copy to .env and fill in locally. Never commit .env.

# Snowflake service user with key-pair auth (see infra/snowflake/00_setup.sql).
# Account: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=FINSIGHT_SVC
SNOWFLAKE_ROLE=FINSIGHT_ENGINEER
SNOWFLAKE_WAREHOUSE=FINSIGHT_WH
SNOWFLAKE_DATABASE=FINSIGHT
# Absolute path; "~" is not expanded.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Public market data; no API key needed.
BINANCE_BASE_URL=https://api.binance.com

FRED_API_KEY=

# Choose openai or anthropic, and set only that provider's key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4.1-mini

LOG_LEVEL=INFO
